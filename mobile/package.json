{
  "name": "taskhive-mobile",
  "version": "1.0.0",
  "description": "TaskHive Mobile App - React Native",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace TaskHiveMobile.xcworkspace -scheme TaskHiveMobile -configuration Release",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-native": "^0.74.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/stack": "^6.3.29",
    "react-native-screens": "^3.31.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-gesture-handler": "^2.16.1",
    "@react-native-community/async-storage": "^1.13.2",
    "@react-native-camera-roll/camera-roll": "^7.4.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-maps": "^1.14.0",
    "react-native-push-notification": "^8.1.1",
    "@react-native-firebase/app": "^18.8.0",
    "@react-native-firebase/messaging": "^18.8.0",
    "@react-native-firebase/analytics": "^18.8.0",
    "axios": "^1.7.4",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@tanstack/react-query": "^5.90.2",
    "zustand": "^4.4.7",
    "react-hook-form": "^7.51.4",
    "zod": "^3.22.4",
    "date-fns": "^3.3.1",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.74.0",
    "typescript": "^5.4.5",
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.2",
    "eslint": "^8.57.0",
    "eslint-config-react-native": "^4.11.0",
    "prettier": "^3.2.5"
  }
}
